.vscode/.ascript-sync.json
__pycache__/
*.pyc
.venv/
dist/
build/
*.spec
*.egg-info/
# 运行时状态（框架缓存 / 用户上次选择的任务模式 / 配置方案）
path_cache.json
config.json
schemes.json
# 调试信息悬浮层运行时文件（任务进程与绘制进程间通信）
debug_overlay_state.json
debug_overlay_helper_exit.txt
# 种族字形库（随挂机自动积累的运行时数据）
team_race_glyphs*.npz
# 本地日志文件（开发调试用，log 同时落盘到 logs/）
logs/
dist_exe/
# 外挂重型依赖（CI 构建生成：numpy/onnxruntime 不编译进 exe，随包分发）
pylibs/
tmp_err_img.png
